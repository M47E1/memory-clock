<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="内存时钟 · 小窗" Width="118" Height="142" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="#F1F6F4" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E5FFC9"/>
            <Setter Property="Background" Value="#233738"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="30">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#34504C"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#E5FFC9"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".7"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="18" Background="#192C29">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="76"/><RowDefinition/></Grid.RowDefinitions>
            <Grid x:Name="Handle" Background="Transparent" Cursor="SizeAll" Margin="9,3,6,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="{Binding Foreground, ElementName=Status}" Margin="1,0,5,0"/>
                    <TextBlock x:Name="Status" Text="就绪" VerticalAlignment="Center" Foreground="#B7CCCA"
                           FontSize="10" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <Button x:Name="Expand" HorizontalAlignment="Right" Width="22" Height="20" Background="Transparent"
                        AutomationProperties.Name="展开主界面" ToolTip="展开主界面">
                    <Path Stroke="#BDD4D0" StrokeThickness="1.3" Data="M 1,7 L 7,1 M 2,1 L 7,1 L 7,6"/>
                </Button>
            </Grid>
            <Grid Grid.Row="1" Width="82" Height="74" HorizontalAlignment="Center">
                <Image x:Name="Dial" Stretch="Uniform" IsHitTestVisible="False"/>
                <Button x:Name="Clean" Width="46" Height="41" Background="Transparent" FontSize="13" FontWeight="SemiBold"
                        Content="Clean" AutomationProperties.Name="Clean，立即清理内存">
                    <Button.ContentTemplate><DataTemplate>
                        <StackPanel>
                            <Path HorizontalAlignment="Center" Width="10" Height="10" Stretch="Uniform" Fill="#CCEBC2"
                                  Data="M 7,0 Q 8,6 14,7 Q 8,8 7,14 Q 6,8 0,7 Q 6,6 7,0 Z"/>
                            <TextBlock Text="{Binding}" HorizontalAlignment="Center" Foreground="#F6FFF6" FontWeight="SemiBold"/>
                        </StackPanel>
                    </DataTemplate></Button.ContentTemplate>
                </Button>
                <TextBlock x:Name="DialPercent" Text="—" Foreground="#CCF59E" FontSize="10" FontWeight="Bold" VerticalAlignment="Bottom"
                           Margin="0,0,0,2" HorizontalAlignment="Center" IsHitTestVisible="False" AutomationProperties.Name="内存占用率"/>
            </Grid>
            <Border Grid.Row="2" CornerRadius="0,0,18,18" Background="#CEE3C8" Padding="6,2">
                <UniformGrid Columns="2" VerticalAlignment="Center">
                    <StackPanel><TextBlock x:Name="Used" Foreground="#18392E" Text="—" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" AutomationProperties.Name="已用内存（GB）"/>
                        <TextBlock Foreground="#405C4E" Text="已用 GB" FontSize="9" TextAlignment="Center"/></StackPanel>
                    <StackPanel><TextBlock x:Name="Free" Foreground="#18392E" Text="—" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" AutomationProperties.Name="剩余内存（GB）"/>
                        <TextBlock Foreground="#405C4E" Text="剩余 GB" FontSize="9" TextAlignment="Center"/></StackPanel>
                </UniformGrid>
            </Border>
        </Grid>
    </Border>
</Window>
