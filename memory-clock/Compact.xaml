<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="内存时钟 · 小窗" Width="104" Height="124" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="#EDF4F1"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" RenderOptions.BitmapScalingMode="HighQuality">
    <Window.Resources>
        <Style x:Key="CoreButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F3FAF4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1C342F"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#C8FA8E"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#142724"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#213834"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#C8FA8E"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="16" Background="#132220">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="22"/>
                <RowDefinition Height="66"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid x:Name="Handle" Background="Transparent" Cursor="SizeAll" Margin="9,4,6,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="{Binding Foreground, ElementName=Status}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Status" Text="就绪" VerticalAlignment="Center" Foreground="#A5BCBA"
                               FontSize="9.5" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <Button x:Name="Expand" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Width="18" Height="18"
                        AutomationProperties.Name="展开主界面" ToolTip="展开主界面">
                    <Path Stroke="#A5BFBB" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 1,6.5 L 6.5,1 M 2,1 L 6.5,1 L 6.5,5.5"/>
                </Button>
            </Grid>
            <Grid Grid.Row="1" Width="74" Height="66" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="Dial" Stretch="Uniform" IsHitTestVisible="False"/>
                <Button x:Name="Clean" Style="{StaticResource CoreButton}" Width="38" Height="38"
                        VerticalAlignment="Top" Margin="0,16.5,0,0" FontSize="11.5" FontWeight="SemiBold"
                        Content="Clean" AutomationProperties.Name="Clean，立即清理内存">
                    <Button.ContentTemplate><DataTemplate>
                        <StackPanel VerticalAlignment="Center">
                            <Path HorizontalAlignment="Center" Width="7.5" Height="7.5" Stretch="Uniform" Fill="#C8FA8E" Margin="0,1,0,1"
                                  Data="M 7,0 Q 8,6 14,7 Q 8,8 7,14 Q 6,8 0,7 Q 6,6 7,0 Z"/>
                            <TextBlock Text="{Binding}" HorizontalAlignment="Center" Foreground="#F4FBF5"
                                       FontSize="11.5" FontWeight="SemiBold" LineHeight="13" LineStackingStrategy="BlockLineHeight"/>
                        </StackPanel>
                    </DataTemplate></Button.ContentTemplate>
                </Button>
                <TextBlock x:Name="DialPercent" Text="—" Foreground="#C8FA8E" FontSize="10" FontWeight="Bold"
                           Typography.NumeralAlignment="Tabular" VerticalAlignment="Bottom" Margin="0,0,0,1"
                           HorizontalAlignment="Center" IsHitTestVisible="False" AutomationProperties.Name="内存占用率"/>
            </Grid>
            <Border Grid.Row="2" CornerRadius="0,0,16,16" Background="#D4E7CE" Padding="5,1,5,3">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="Used" Foreground="#112B22" Text="—" FontSize="13" FontWeight="Bold"
                                   Typography.NumeralAlignment="Tabular" LineHeight="14" LineStackingStrategy="BlockLineHeight"
                                   TextAlignment="Center" AutomationProperties.Name="已用内存（GB）"/>
                        <TextBlock Foreground="#3D5C50" Text="已用 GB" FontSize="8.5" FontWeight="Medium" Margin="0,1,0,0" TextAlignment="Center"/>
                    </StackPanel>
                    <Rectangle Grid.Column="1" Width="1" Height="18" Fill="#B4CEAF" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="Free" Foreground="#112B22" Text="—" FontSize="13" FontWeight="Bold"
                                   Typography.NumeralAlignment="Tabular" LineHeight="14" LineStackingStrategy="BlockLineHeight"
                                   TextAlignment="Center" AutomationProperties.Name="剩余内存（GB）"/>
                        <TextBlock Foreground="#3D5C50" Text="剩余 GB" FontSize="8.5" FontWeight="Medium" Margin="0,1,0,0" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
