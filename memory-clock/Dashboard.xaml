<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="内存时钟 · Memory Clock" Width="764" Height="552" MinWidth="728" MinHeight="548"
        WindowStartupLocation="CenterScreen" Background="#0B1112" Foreground="#EDF4F1"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" RenderOptions.BitmapScalingMode="HighQuality">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#89A19E"/>
        <SolidColorBrush x:Key="Lime" Color="#C8FA8E"/>
        <SolidColorBrush x:Key="Azure" Color="#9AD1E8"/>
        <SolidColorBrush x:Key="Amber" Color="#ECCB8E"/>
        <SolidColorBrush x:Key="Panel" Color="#141F21"/>
        <SolidColorBrush x:Key="Inset" Color="#0E1719"/>
        <SolidColorBrush x:Key="MemorySurface" Color="#D4E7CE"/>
        <SolidColorBrush x:Key="MemoryInk" Color="#112B22"/>
        <SolidColorBrush x:Key="MemoryMuted" Color="#3E5D50"/>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#132022"/>
            <Setter Property="Foreground" Value="#EAF3EF"/>
            <Setter Property="BorderBrush" Value="#253A3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E4EFEA"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Background" Value="{StaticResource Panel}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EDF6F2"/>
            <Setter Property="Background" Value="#203235"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="surface" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Opacity" Value=".88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="surface" Property="Opacity" Value=".74"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="surface" Property="BorderBrush" Value="#EDF6F2"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="surface" Property="Opacity" Value=".45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Entry" Background="{TemplateBinding Background}" CornerRadius="8"
                            BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Entry" Property="BorderBrush" Value="{StaticResource Amber}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Entry" Property="Opacity" Value=".65"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#D5E3DF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Choice" BorderThickness="1" CornerRadius="9" BorderBrush="Transparent"
                            Background="#192729" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Grid Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse x:Name="Outline" Stroke="#6E8784" StrokeThickness="1.3"/>
                                <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{StaticResource Lime}" Visibility="Hidden"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="Background" Value="#203134"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="#F3FAF7"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Outline" Property="Stroke" Value="{StaticResource Lime}"/>
                            <Setter TargetName="Choice" Property="Background" Value="#1E352D"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{StaticResource Azure}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Choice" Property="Opacity" Value=".65"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="SegTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#89A19E"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="9,2.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Pill" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="#1C2C2F"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="#EFF8F4"/>
                            <Setter TargetName="Pill" Property="Background" Value="#243C35"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Azure}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Pill" Property="Opacity" Value=".6"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="RingButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DFF3DA"/>
            <Setter Property="Background" Value="#132220"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RingSurface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RingSurface" Property="Background" Value="#1C332F"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RingSurface" Property="BorderBrush" Value="#C8FA8E"/><Setter TargetName="RingSurface" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="RingSurface" Property="Background" Value="#0E1B19"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Foreground" Value="{StaticResource MemoryInk}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#B1CDB0" CornerRadius="3">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3"
                                        Background="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20,14,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource Lime}" Width="32" Height="32" CornerRadius="9" Margin="0,0,10,0">
                        <Path Width="18" Height="18" Stretch="Uniform" Stroke="#112718" StrokeLineJoin="Round" StrokeThickness="1.8"
                              Data="M4,8 L10,8 10,5 17,5 17,8 22,8 22,19 4,19 Z M7,19 L7,23 M11,19 L11,23 M15,19 L15,23 M19,19 L19,23 M6,12 L10,12 12,15 15,10 17,12 20,12"/>
                    </Border>
                    <TextBlock FontSize="19" FontWeight="SemiBold" Text="内存时钟" Foreground="#F1F7F4" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox x:Name="Startup" Content="开机自启" Foreground="#CBDCD7" VerticalAlignment="Center"
                              Margin="0,0,8,0" FontSize="12" Cursor="Hand" ToolTipService.ShowOnDisabled="True"
                              AutomationProperties.Name="开机自启" AutomationProperties.HelpText="登录时启动到托盘，不自动清理">
                        <CheckBox.Template><ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="7,4">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="Track" Width="26" Height="15" Background="#2C3F41" CornerRadius="7.5" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Ellipse x:Name="Thumb" Width="9" Height="9" Fill="#D8E5E0" Margin="3,0" HorizontalAlignment="Left"/>
                                    </Border>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{StaticResource Lime}"/>
                                    <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource MemoryInk}"/>
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#162426"/></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Azure}"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".6"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></CheckBox.Template>
                    </CheckBox>
                    <Border VerticalAlignment="Center" CornerRadius="12" Padding="10,5" Background="#142224">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ScheduleDot" Width="6" Height="6" Fill="{StaticResource Muted}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ScheduleState" FontSize="11.5" Foreground="#C4D7D4" Text="定时未启用"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="Columns" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.04*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="MemoryBlock" Style="{StaticResource Card}" Background="{StaticResource MemorySurface}" Padding="20,16"
                        ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="15000" ToolTip="正在读取占用内存前三的程序…">
                    <StackPanel>
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="物理内存占用" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MemoryMuted}"/>
                                <TextBlock x:Name="Usage" Text="—" FontSize="48" FontWeight="SemiBold" Foreground="{StaticResource MemoryInk}"
                                           TextOptions.TextFormattingMode="Ideal" Typography.NumeralAlignment="Tabular"
                                           LineHeight="52" LineStackingStrategy="BlockLineHeight" Margin="-2,5,0,8"/>
                            </StackPanel>
                            <Button x:Name="Compact" Style="{StaticResource RingButton}" Width="72" Height="72"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    AutomationProperties.Name="最小化为环" ToolTip="缩成浮动内存环">
                                <StackPanel IsHitTestVisible="False" VerticalAlignment="Center">
                                    <Grid Width="46" Height="40" HorizontalAlignment="Center">
                                        <Image x:Name="MiniDial" Stretch="Uniform"/>
                                        <Viewbox Width="10.5" Height="9.5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" Stretch="Uniform">
                                            <Canvas x:Name="MiniRocketGroup" Width="14" Height="12">
                                                <Canvas.RenderTransform><TranslateTransform x:Name="MiniRocketShift"/></Canvas.RenderTransform>
                                                <Path x:Name="MiniRocketHull" Fill="#C8FA8E" Stroke="#C8FA8E" StrokeThickness="1.2" StrokeLineJoin="Round"
                                                      Data="M 11.0,1.4 C 8.5,1.6 6.2,3.1 4.6,5.5 L 7.7,8.6 C 10.1,7.0 11.6,4.7 11.8,2.2 C 11.8,1.7 11.5,1.4 11.0,1.4 Z"/>
                                                <Path x:Name="MiniRocketFins" Stroke="#C8FA8E" StrokeThickness="1.15" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Data="M 4.6,5.5 L 2.2,6.0 L 3.8,7.6 M 7.7,8.6 L 7.2,11.0 L 5.6,9.4"/>
                                                <Ellipse Canvas.Left="7.4" Canvas.Top="3.4" Width="2.1" Height="2.1" Fill="#0C1715"/>
                                                <Path x:Name="MiniRocketFlame" Opacity="0" Stroke="#F4C86A" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="M 4.4,8.8 L 1.7,11.3 M 5.4,9.6 L 3.6,11.4"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                    <TextBlock x:Name="CompactLabel" Text="最小化" FontWeight="SemiBold" FontSize="10.5"
                                               Foreground="#DDF2D8" Margin="0,0,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ProgressBar x:Name="Meter" Maximum="100" Margin="0,4,0,14" AutomationProperties.Name="物理内存占用率"/>
                        <Grid Margin="0,0,0,11">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource MemoryMuted}" Text="可用内存"/>
                                <TextBlock x:Name="Available" Text="—" FontSize="18" Foreground="{StaticResource MemoryInk}"
                                           FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource MemoryMuted}" Text="物理内存总量"/>
                                <TextBlock x:Name="Physical" Text="—" FontSize="18" Foreground="{StaticResource MemoryInk}"
                                           FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Rectangle Height="1" Fill="#BDD6B9" Margin="0,0,0,9"/>
                        <DockPanel>
                            <TextBlock Text="系统提交用量" Style="{StaticResource Caption}" Foreground="{StaticResource MemoryMuted}"/>
                            <TextBlock x:Name="Commit" Text="—" TextAlignment="Right" FontSize="11.5" FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular" Foreground="#1E4034"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ResultBlock" Grid.Row="2" Style="{StaticResource Card}" Padding="20,14">
                    <StackPanel VerticalAlignment="Center">
                        <DockPanel Margin="0,0,0,11">
                            <TextBlock x:Name="Delta" DockPanel.Dock="Right" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource Lime}" Typography.NumeralAlignment="Tabular"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                            <TextBlock Text="上次清理 · 可用内存" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="清理前"/>
                                <TextBlock x:Name="Before" Text="—" FontSize="17" FontWeight="SemiBold" Foreground="#EFF7F4"
                                           Typography.NumeralAlignment="Tabular" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Rectangle Grid.Column="1" Width="1" Fill="#203134" Margin="8,2,12,2"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Caption}" Text="清理后"/>
                                <TextBlock x:Name="After" Text="—" FontSize="17" FontWeight="SemiBold" Foreground="#EFF7F4"
                                           Typography.NumeralAlignment="Tabular" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Rectangle Grid.Column="3" Width="1" Fill="#203134" Margin="8,2,12,2"/>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource Caption}" Text="30 秒后"/>
                                <TextBlock x:Name="Later" Text="—" FontSize="17" FontWeight="SemiBold" Foreground="#EFF7F4"
                                           Typography.NumeralAlignment="Tabular" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="Result" Text="本次运行尚未清理" Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Border>

                <Border x:Name="ControlsBlock" Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource Card}" Padding="20,16">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="清理模式" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                            <RadioButton x:Name="Gentle" GroupName="Mode" Content="温和 · 只清系统缓存"
                                         ToolTip="清理 Windows 系统文件缓存和低优先级待机缓存，不会关闭应用"/>
                            <RadioButton x:Name="Strong" GroupName="Mode" Content="强力 · 额外腾出应用内存（可能短暂变慢）"
                                         ToolTip="先整理应用工作集，再执行温和清理；应用保持打开，切回时可能短暂变慢"/>
                            <TextBlock Text="两种模式均不会关闭正在运行的应用。" FontSize="11" Foreground="#748D8A" Margin="2,0,0,0"/>
                            <Border x:Name="TimerBlock" Padding="13,10" CornerRadius="11" Background="{StaticResource Inset}" Margin="0,12,0,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock x:Name="Next" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"
                                                   Text="下次清理：未启用" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <Border Background="#162426" CornerRadius="7" Padding="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="TriggerInterval" Style="{StaticResource SegTab}" GroupName="Trigger"
                                                             Content="按时间" IsChecked="True" AutomationProperties.Name="按时间自动清理"/>
                                                <RadioButton x:Name="TriggerThreshold" Style="{StaticResource SegTab}" GroupName="Trigger"
                                                             Content="按占用" AutomationProperties.Name="按内存占用自动清理"/>
                                            </StackPanel>
                                        </Border>
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Grid Margin="0,0,8,0">
                                            <TextBox x:Name="Seconds" FontSize="14.5" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                                                     MaxLength="5" Padding="8,4,26,4" MinHeight="34"
                                                     Background="#182426" Foreground="#F1F7F4" CaretBrush="#F1F7F4"
                                                     AutomationProperties.Name="清理间隔（秒）" AutomationProperties.HelpText="输入 10 至 86400 之间的整数"/>
                                            <TextBlock x:Name="TriggerUnit" Text="秒" Style="{StaticResource Caption}" Margin="0,0,9,0"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" IsHitTestVisible="False"/>
                                        </Grid>
                                        <Button x:Name="Arm" Grid.Column="1" Content="启用定时" MinWidth="88" MinHeight="34" Padding="12,5"
                                                FontSize="12.5" Background="{StaticResource Amber}" Foreground="#271E10"/>
                                    </Grid>
                                    <TextBlock x:Name="TimeHint" Text="10–86400 秒 · 开启先清一次，完后重计" FontSize="11"
                                               Style="{StaticResource Caption}" Margin="1,7,0,0" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <Button x:Name="Clean" Content="立即清理" MinHeight="40" FontSize="13.5" FontWeight="Bold"
                                    Background="{StaticResource Lime}" Foreground="#112718"/>
                            <TextBlock x:Name="Permission" FontSize="11" Foreground="#748D8A" Text="清理需要管理员权限。"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <Border x:Name="DiskBlock" Grid.Row="2" Style="{StaticResource Card}" Background="#111B1E" CornerRadius="13" Padding="14,10" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="8" Background="#192B31" Margin="0,0,11,0" VerticalAlignment="Center">
                        <Path Width="15" Height="12" Stretch="Uniform" Stroke="{StaticResource Azure}" StrokeThickness="1.5" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M 3,1 L 15,1 18,9 18,14 0,14 0,9 Z M 0,9 L 18,9 M 12,11.5 L 15,11.5"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="磁盘虚拟内存" FontSize="13" FontWeight="SemiBold" Foreground="#E4EFEA" Margin="0,0,10,0" VerticalAlignment="Top"/>
                            <TextBlock x:Name="PageFileSummary" Grid.Column="1" FontSize="11.5" Foreground="{StaticResource Azure}" VerticalAlignment="Bottom"
                                       Margin="0,1,0,1" Typography.NumeralAlignment="Tabular" Text="正在读取 Windows 分页文件…"/>
                        </Grid>
                        <TextBlock x:Name="PageFileHint" Style="{StaticResource Caption}" FontSize="11"
                                   Text="SSD 仅作磁盘虚拟内存备用，点右侧在系统设置选「高级 → 虚拟内存 → 更改」。"
                                   Margin="0,2,0,0" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
