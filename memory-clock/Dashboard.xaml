<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="内存时钟 · Memory Clock" Width="930" Height="715" MinWidth="860" MinHeight="675"
        WindowStartupLocation="CenterScreen" Background="#0D1417" Foreground="#F1F6F4"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#A6B9B6"/>
        <SolidColorBrush x:Key="Lime" Color="#C9FA90"/>
        <SolidColorBrush x:Key="Azure" Color="#AEDCF6"/>
        <SolidColorBrush x:Key="Amber" Color="#F6D394"/>
        <SolidColorBrush x:Key="Panel" Color="#1E292B"/>
        <SolidColorBrush x:Key="MemorySurface" Color="#CEE3C8"/>
        <SolidColorBrush x:Key="MemoryInk" Color="#19392E"/>
        <SolidColorBrush x:Key="MemoryMuted" Color="#425E52"/>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Kicker" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Lime}"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Background" Value="{StaticResource Panel}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EEF8F4"/>
            <Setter Property="Background" Value="#263B3E"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="surface" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Opacity" Value=".85"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="surface" Property="Opacity" Value=".7"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="surface" Property="BorderBrush" Value="White"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="surface" Property="Opacity" Value=".45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Entry" Background="{TemplateBinding Background}" CornerRadius="6"
                            BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Entry" Property="BorderBrush" Value="{StaticResource Amber}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Entry" Property="Opacity" Value=".7"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#EEF8F4"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Choice" BorderThickness="1" CornerRadius="7" BorderBrush="Transparent"
                            Background="Transparent" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Grid Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse x:Name="Outline" Stroke="#91A7A5" StrokeThickness="1.2"/>
                                <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource Lime}" Visibility="Hidden"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="Background" Value="#233337"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Outline" Property="Stroke" Value="{StaticResource Lime}"/>
                            <Setter TargetName="Choice" Property="Background" Value="#263833"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{StaticResource Azure}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Choice" Property="Opacity" Value=".72"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="RingButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6F5F3"/>
            <Setter Property="Background" Value="#2D5044"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RingSurface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RingSurface" Property="Background" Value="#416558"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RingSurface" Property="BorderBrush" Value="White"/><Setter TargetName="RingSurface" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="RingSurface" Property="Background" Value="#172D30"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#A6C2A7" CornerRadius="4">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4"
                                        Background="{StaticResource MemoryInk}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="27,20,27,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource Lime}" Width="48" Height="48" CornerRadius="13" Margin="0,0,13,0">
                        <Path Width="26" Height="26" Stretch="Uniform" Stroke="#162717" StrokeLineJoin="Round" StrokeThickness="1.8"
                              Data="M4,8 L10,8 10,5 17,5 17,8 22,8 22,19 4,19 Z M7,19 L7,23 M11,19 L11,23 M15,19 L15,23 M19,19 L19,23 M6,12 L10,12 12,15 15,10 17,12 20,12"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Kicker}" Text="MEMORY CLOCK  /  WINDOWS"/>
                        <TextBlock FontSize="27" FontWeight="SemiBold" Text="内存时钟" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox x:Name="Startup" Content="开机自启" Foreground="#DEEADC" VerticalAlignment="Center"
                              Margin="0,0,10,0" FontSize="12" Cursor="Hand" ToolTipService.ShowOnDisabled="True"
                              AutomationProperties.Name="开机自启" AutomationProperties.HelpText="登录时启动到托盘，不自动清理">
                        <CheckBox.Template><ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="7,6">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="Track" Width="28" Height="16" Background="#526667" CornerRadius="8" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Ellipse x:Name="Thumb" Width="10" Height="10" Fill="#E4ECE7" Margin="3,0" HorizontalAlignment="Left"/>
                                    </Border>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{StaticResource Lime}"/>
                                    <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource MemoryInk}"/>
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#233337"/></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Azure}"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".65"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></CheckBox.Template>
                    </CheckBox>
                <Border VerticalAlignment="Center" CornerRadius="14" Padding="12,6"
                        Background="#203231">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ScheduleDot" Width="7" Height="7" Fill="{StaticResource Muted}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ScheduleState" FontSize="12" Text="定时未启用"/>
                    </StackPanel>
                </Border>
                </StackPanel>
            </Grid>
            <Grid x:Name="Columns" Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border x:Name="MemoryBlock" Style="{StaticResource Card}" Background="{StaticResource MemorySurface}" Padding="22,18">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource MemoryMuted}" Text="LIVE MEMORY"/>
                                    <TextBlock Text="物理内存占用" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource MemoryInk}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="Usage" Text="—" FontSize="57" FontWeight="Normal" Foreground="{StaticResource MemoryInk}" Margin="0,0,0,4"/>
                                </StackPanel>
                                <Button x:Name="Compact" Style="{StaticResource RingButton}" Width="78" Height="75"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        AutomationProperties.Name="最小化为环" ToolTip="缩成浮动内存环">
                                    <StackPanel IsHitTestVisible="False">
                                        <Grid Width="54" Height="47" HorizontalAlignment="Center">
                                            <Image x:Name="MiniDial" Stretch="Uniform"/>
                                            <Path HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#E8F9DA"
                                                  Data="M 7,0 Q 8,6 14,7 Q 8,8 7,14 Q 6,8 0,7 Q 6,6 7,0 Z"/>
                                        </Grid>
                                        <TextBlock x:Name="CompactLabel" Text="最小化" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ProgressBar x:Name="Meter" Maximum="100" AutomationProperties.Name="物理内存占用率"/>
                            <Grid Margin="0,15,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource MemoryMuted}" Text="可用内存"/>
                                    <TextBlock x:Name="Available" Text="—" FontSize="20" Foreground="{StaticResource MemoryInk}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource MemoryMuted}" Text="物理内存总量"/>
                                    <TextBlock x:Name="Physical" Text="—" FontSize="20" Foreground="{StaticResource MemoryInk}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock Text="系统提交用量" Style="{StaticResource Caption}" Foreground="{StaticResource MemoryMuted}"/>
                                <TextBlock x:Name="Commit" Text="—" TextAlignment="Right" FontSize="12" Foreground="{StaticResource MemoryInk}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ResultBlock" Grid.Row="2" Style="{StaticResource Card}" Background="#1C3332" Padding="22,17">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Kicker}" Foreground="#B5D9CB" Text="LAST RUN"/>
                            <TextBlock Text="上次清理 · 可用内存" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,11"/>
                            <UniformGrid Columns="3">
                                <StackPanel><TextBlock Style="{StaticResource Caption}" Text="清理前"/><TextBlock x:Name="Before" Text="—" FontSize="19"/></StackPanel>
                                <StackPanel><TextBlock Style="{StaticResource Caption}" Text="清理后"/><TextBlock x:Name="After" Text="—" FontSize="19"/></StackPanel>
                                <StackPanel><TextBlock Style="{StaticResource Caption}" Text="30 秒后"/><TextBlock x:Name="Later" Text="—" FontSize="19"/></StackPanel>
                            </UniformGrid>
                            <TextBlock x:Name="Result" Text="本次运行尚未清理" Style="{StaticResource Caption}" Margin="0,9,0,0"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Border>
                <Border x:Name="ControlsBlock" Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource Card}" Padding="22,18">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Muted}" Text="CLEAN CONTROLS"/>
                        <TextBlock FontSize="21" FontWeight="SemiBold" Text="清理内存" Margin="0,4,0,12"/>
                        <RadioButton x:Name="Gentle" GroupName="Mode" Content="温和：只清 Windows 的系统缓存"
                                     ToolTip="清理系统文件缓存和低优先级待机缓存"/>
                        <RadioButton x:Name="Strong" GroupName="Mode" Content="强力：额外腾出应用内存，可能短暂变慢"
                                     ToolTip="先整理应用工作集，再执行温和清理"/>
                        <TextBlock Text="两种模式都不会关闭应用。" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        <Border x:Name="TimerBlock" Padding="14,11" CornerRadius="10" Background="#34332C" Margin="0,15,0,0">
                            <StackPanel>
                                <TextBlock Text="间隔自动清理" Foreground="{StaticResource Amber}" FontWeight="SemiBold"/>
                                <TextBlock Text="开启先清一次，之后每轮结束后重新计时。" Style="{StaticResource Caption}" Margin="0,3,0,9"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid Margin="0,0,8,0">
                                        <TextBox x:Name="Seconds" FontSize="16" MaxLength="5" Padding="9,5,30,5" MinHeight="36"
                                                 Background="#161D1E" Foreground="#F1F6F4" CaretBrush="White"
                                                 AutomationProperties.Name="清理间隔（秒）" AutomationProperties.HelpText="输入 10 至 86400 之间的整数"/>
                                        <TextBlock Text="秒" Style="{StaticResource Caption}" Margin="0,0,9,0" VerticalAlignment="Center" HorizontalAlignment="Right" IsHitTestVisible="False"/>
                                    </Grid>
                                    <Button x:Name="Arm" Grid.Column="1" Content="启用定时" MinWidth="98" MinHeight="36"
                                            Background="{StaticResource Amber}" Foreground="#2F2417"/>
                                </Grid>
                                <TextBlock x:Name="TimeHint" Text="10–86400 秒 · 启用时一起保存" Style="{StaticResource Caption}" Margin="0,5,0,0"
                                           AutomationProperties.LiveSetting="Polite"/>
                                <TextBlock x:Name="Next" Foreground="{StaticResource Amber}" Text="下次清理：未启用" FontSize="12" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="Clean" Content="立即清理" Margin="0,16,0,0" Background="{StaticResource Lime}" Foreground="#182B18"/>
                        <TextBlock x:Name="Permission" Style="{StaticResource Caption}" Text="清理需要管理员权限。" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Border x:Name="DiskBlock" Grid.Row="2" Style="{StaticResource Card}" Background="#222F34" Padding="20,12" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="9" Background="#203940" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Path Stroke="{StaticResource Azure}" StrokeThickness="1.5" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M 3,1 L 15,1 18,9 18,14 0,14 0,9 Z M 0,9 L 18,9 M 12,11.5 L 15,11.5"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="磁盘虚拟内存" FontSize="16" FontWeight="SemiBold" Margin="0,0,12,0"/>
                            <TextBlock x:Name="PageFileSummary" FontSize="12" Foreground="{StaticResource Azure}" VerticalAlignment="Center" Text="正在读取 Windows 分页文件…"/>
                        </StackPanel>
                        <TextBlock x:Name="PageFileHint" Style="{StaticResource Caption}" Text="SSD 可作备用空间。点调整大小后，选「高级 → 虚拟内存 → 更改」。"
                                   Margin="0,3,0,0" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <Button x:Name="PageFileSettings" Grid.Column="2" Content="调整大小 ↗" VerticalAlignment="Center" MinHeight="32" Padding="12,5" Margin="9,0,0,0"
                            Foreground="{StaticResource Azure}" Background="#304751" AutomationProperties.Name="打开 Windows 虚拟内存大小设置"/>
                </Grid>
            </Border>
            <DockPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock DockPanel.Dock="Right" Text="MEMORY CLOCK  /  1.5" Style="{StaticResource Kicker}" Foreground="{StaticResource Muted}" TextAlignment="Right" Margin="10,0,0,0"/>
                <TextBlock Text="清理核心源自 Mem Reduct v.3.5.2 · Henry++ · GPLv3" Style="{StaticResource Caption}"/>
            </DockPanel>
        </Grid>
    </ScrollViewer>
</Window>
